# Gill AI — server-side AI provider configuration.
#
# Copy this file to `.env` and fill in real values there. `.env` is
# git-ignored (see .gitignore) and is only ever read on the server
# (inside src/pages/api/chat.ts) — it is never bundled into client
# JavaScript and never exposed to the browser.
#
# Do NOT put a real key in this file (.env.example). Leave it blank
# here; only the untracked local `.env` file should hold the real
# secret.

# Optional. "nvidia" or "anthropic". If empty, it is guessed from the
# key prefix (a key starting with "nvapi-" is treated as NVIDIA).
AI_PROVIDER=

# Required to enable real AI-generated answers.
# NVIDIA: https://build.nvidia.com/  |  Anthropic: https://console.anthropic.com/
# If left empty, Gill AI falls back to the local rule-based engine.
AI_API_KEY=

# Optional. Overrides the model used for Gill AI responses.
# Leave blank to use the built-in default (see src/pages/api/chat.ts).
# Example for NVIDIA: meta/llama-3.3-70b-instruct
AI_MODEL=