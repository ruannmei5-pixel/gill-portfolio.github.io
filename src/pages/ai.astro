---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import AiAssistant from "@components/ai/AiAssistant.astro";
import Button from "@components/ui/Button.astro";

// Phase 09 — the dedicated full-page entry point for the AI Assistant
// (linked from the "AI" pill in the nav bar). This renders the exact
// same <AiAssistant /> component as the in-page "Ask Gill AI" section
// on the homepage (`@components/sections/AskGillAi.astro`) — one
// implementation, two access points, never two different assistants.
---

<BaseLayout
  title="Ask Gill AI — Gill"
  description="Ask an AI assistant questions about Gill's background, skills, and projects — answered only from verified portfolio data."
>
  <section class="py-24">
    <Container class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-signal-bright">Portfolio Intelligence</p>
      <h1 class="mt-2 font-display text-display-md text-ink">Ask Gill AI</h1>
      <p class="mt-3 text-ink-muted">
        Curious about my journey, projects, or technical interests? Ask the assistant below — it only answers
        from what's actually verified on this portfolio.
      </p>

      <AiAssistant class="mt-8" />

      <div class="mt-8">
        <Button href="/#contact" variant="secondary">Prefer to reach out directly? Go to Contact</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
