---
import SectionShell from "@components/layout/SectionShell.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import SkillCard from "@components/cards/SkillCard.astro";
import { skillCategories, technicalFocus, skillProgression } from "@data/skills";

const primaryCategories = skillCategories.filter((category) => category.primary);
const supportingCategories = skillCategories.filter((category) => !category.primary);
---

<SectionShell id="skills">
  <SectionHeader
    index="04"
    eyebrow="Technical Profile"
    title="What I'm building with"
    description="Technologies and areas I'm exploring through projects, experimentation, and continuous learning."
  />

  <!-- Technical context panel — a compact "current state" readout, not a
       separate invented metric: both lists are short summaries of the
       category data below. -->
  <div class="rounded-md border border-border-subtle bg-void-raised/60 p-6 shadow-panel">
    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-signal-bright">
          Current focus
        </h3>
        <ul class="mt-3 space-y-2">
          {
            technicalFocus.currentFocus.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-muted">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-signal" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">
          Currently exploring
        </h3>
        <ul class="mt-3 space-y-2">
          {
            technicalFocus.currentlyExploring.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-muted">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full border border-ink-faint" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Four primary pillars — Web Development, Networking, Linux & Server, AI -->
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {primaryCategories.map((category) => <SkillCard category={category} />)}
  </div>

  <!-- Supporting areas — real, but not one of the four main pillars -->
  {
    supportingCategories.length > 0 ? (
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {supportingCategories.map((category) => (
          <div class="sm:col-span-1 lg:col-span-2">
            <SkillCard category={category} />
          </div>
        ))}
      </div>
    ) : null
  }

  <!-- Skill development sequence — a structural sequence, not a chart:
       the four pillars build on one another from the TJKT foundation
       up to the current, still-forming interest in AI. -->
  <div class="mt-10">
    <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">
      How it connects
    </h3>
    <ol class="mt-4 flex flex-col items-start gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
      {
        skillProgression.map((stage, i) => (
          <li class="flex items-center gap-3">
            <span class="rounded-sm border border-border-subtle bg-surface px-2.5 py-1 font-mono text-[0.6875rem] uppercase tracking-wide text-ink-muted">
              {stage.label}
            </span>
            {i < skillProgression.length - 1 ? (
              <span class="rotate-90 text-ink-faint sm:rotate-0" aria-hidden="true">
                →
              </span>
            ) : null}
          </li>
        ))
      }
    </ol>
  </div>

  <p class="mt-10 max-w-prose border-l-2 border-signal-dim pl-4 text-ink-muted">
    This isn't a finished skillset — it's what's currently being built,
    one project at a time.
  </p>
</SectionShell>
