---
import SectionShell from "@components/layout/SectionShell.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import FeaturedProjectCard from "@components/cards/FeaturedProjectCard.astro";
import ProjectCard from "@components/cards/ProjectCard.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import { projects, upcomingProjectAreas } from "@data/projects";

const featuredProjects = projects.filter((project) => project.featured);
const otherProjects = projects.filter((project) => !project.featured);
---

<SectionShell id="projects">
  <SectionHeader
    index="05"
    eyebrow="Selected Work"
    title="Things I've built"
    description="Projects, experiments, and technical work that shaped my journey."
  />

  {
    projects.length > 0 ? (
      <div class="flex flex-col gap-6">
        {featuredProjects.map((project) => (
          <FeaturedProjectCard project={project} />
        ))}

        {otherProjects.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {otherProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        ) : null}
      </div>
    ) : (
      <EmptyState message="no projects logged yet" />
    )
  }

  {
    upcomingProjectAreas.length > 0 ? (
      <div class="mt-8 rounded-md border border-dashed border-border-subtle bg-void-raised/40 p-6">
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">
          More experiments coming
        </p>
        <p class="mt-2 max-w-prose text-sm text-ink-muted">
          Real experience exists in these areas too — write-ups will land here once they're
          verified and worth telling properly.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {upcomingProjectAreas.map((area) => (
            <li class="rounded-sm bg-surface-raised px-2 py-1 font-mono text-[0.6875rem] text-ink-faint">
              {area.label}
            </li>
          ))}
        </ul>
      </div>
    ) : null
  }
</SectionShell>
