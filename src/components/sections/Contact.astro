---
import SectionShell from "@components/layout/SectionShell.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import Button from "@components/ui/Button.astro";
import { profile } from "@data/profile";

const { contact } = profile;

const subject = encodeURIComponent("Halo Gill, saya melihat portofoliomu");
const mailto = `mailto:${contact.email}?subject=${subject}`;
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(contact.email)}&su=${subject}`;

// Hanya tampilkan tombol yang linknya sudah terisi.
const socials = [
  { label: "LinkedIn", href: contact.linkedin },
  { label: "GitHub", href: contact.github },
  { label: "Instagram", href: contact.instagram },
].filter((s) => Boolean(s.href));
---

<SectionShell id="contact">
  <SectionHeader
    index="09"
    title="Contact"
    description="Open to internships, collaborations, and conversations about networking, web development, or AI."
  />

  <div class="flex flex-wrap items-center gap-4">
    <Button href={mailto} variant="primary" data-email-link data-gmail={gmail}>Email</Button>
    {
      socials.map((s) => (
        <Button href={s.href} variant="secondary" target="_blank" rel="noopener noreferrer">
          {s.label}
        </Button>
      ))
    }
  </div>

  <p class="mt-4 font-mono text-xs text-ink-faint">
    atau salin langsung: <span class="text-ink-muted select-all">{contact.email}</span>
  </p>
</SectionShell>

<script>
  const link = document.querySelector<HTMLAnchorElement>("[data-email-link]");
  if (link) {
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    link.addEventListener("click", (event) => {
      // Mobile: biarkan mailto: membuka aplikasi email bawaan.
      if (isMobile) return;
      // Desktop: buka compose Gmail di tab baru.
      event.preventDefault();
      window.open(link.dataset.gmail, "_blank", "noopener");
    });
  }
</script>