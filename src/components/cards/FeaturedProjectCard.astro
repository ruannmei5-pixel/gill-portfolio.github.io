---
import type { Project, ProjectStatus } from "@/types";
import Card from "@components/ui/Card.astro";
import Badge from "@components/ui/Badge.astro";
import TechTag from "@components/ui/TechTag.astro";
import ArchitectureFlow from "@components/cards/ArchitectureFlow.astro";
import { hoverCardGlow, hoverTechTag } from "@/lib/ui";

export interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusBadges: Record<ProjectStatus, { label: string; tone: "signal" | "neutral" }[]> = {
  prototype: [{ label: "Prototype", tone: "neutral" }],
  "complete-not-deployed": [
    { label: "Complete", tone: "signal" },
    { label: "Not deployed", tone: "neutral" },
  ],
  "in-progress": [{ label: "In progress", tone: "signal" }],
  shipped: [{ label: "Shipped", tone: "signal" }],
  archived: [{ label: "Archived", tone: "neutral" }],
};

const hasStory = Boolean(project.problem || project.approach || project.result);
---

<Card as="article" class={`group ${hoverCardGlow}`}>
  <div class="grid gap-8 lg:grid-cols-[3fr_2fr]">
    <div class="flex flex-col">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <h3 class="font-display text-2xl text-ink">{project.title}</h3>
            {project.team ? <Badge tone="neutral">Team project</Badge> : null}
          </div>
          <p class="mt-1 font-mono text-xs text-ink-faint">{project.category}</p>
        </div>
        <div class="flex shrink-0 flex-col items-end gap-1.5">
          {statusBadges[project.status].map((badge) => <Badge tone={badge.tone}>{badge.label}</Badge>)}
        </div>
      </div>

      <p class="mt-4 text-ink-muted">{project.summary}</p>

      {
        project.contribution ? (
          <div class="mt-5 rounded-sm border border-signal-dim bg-signal-wash px-4 py-3">
            <p class="font-mono text-xs uppercase tracking-wide text-signal-bright">My contribution</p>
            <p class="mt-1 text-sm text-ink-muted">{project.contribution}</p>
          </div>
        ) : null
      }

      <div class="mt-5 flex flex-wrap gap-2">
        {project.technologies.map((tech) => <TechTag class={hoverTechTag}>{tech}</TechTag>)}
      </div>

      {
        hasStory ? (
          <details class="group/details mt-5 border-t border-border-subtle pt-4">
            <summary class="cursor-pointer select-none font-mono text-xs uppercase tracking-wide text-ink-faint transition-colors duration-250 hover:text-signal-bright">
              Technical story
              <span class="ml-1.5 inline-block transition-transform duration-250 group-open/details:rotate-180" aria-hidden="true">
                ↓
              </span>
            </summary>
            <div class="mt-4 space-y-4">
              {project.problem ? (
                <div>
                  <p class="font-mono text-[0.6875rem] uppercase tracking-wide text-ink-faint">Problem</p>
                  <p class="mt-1 text-sm text-ink-muted">{project.problem}</p>
                </div>
              ) : null}
              {project.approach ? (
                <div>
                  <p class="font-mono text-[0.6875rem] uppercase tracking-wide text-ink-faint">Approach</p>
                  <p class="mt-1 text-sm text-ink-muted">{project.approach}</p>
                </div>
              ) : null}
              {project.result ? (
                <div>
                  <p class="font-mono text-[0.6875rem] uppercase tracking-wide text-ink-faint">Result</p>
                  <p class="mt-1 text-sm text-ink-muted">{project.result}</p>
                </div>
              ) : null}
            </div>
          </details>
        ) : null
      }

      {
        project.links && (project.links.live || project.links.repo) ? (
          <div class="mt-5 flex flex-wrap items-center gap-4 text-sm">
            {project.links.live ? (
              <a href={project.links.live} class="text-signal-bright hover:underline">
                View project
              </a>
            ) : null}
            {project.links.repo ? (
              <a href={project.links.repo} class="text-signal-bright hover:underline">
                Source
              </a>
            ) : null}
            <span class="font-mono text-[0.6875rem] text-ink-faint">
              External demo link — availability not guaranteed
            </span>
          </div>
        ) : null
      }
    </div>

    <div class="flex flex-col justify-center rounded-md border border-border-subtle bg-void-raised/60 p-5">
      {
        project.architecture && project.architecture.length > 0 ? (
          <ArchitectureFlow
            steps={project.architecture}
            direction="vertical"
            label="System overview"
            note="Conceptual overview of how the pieces relate — not a verified live data-flow diagram."
          />
        ) : null
      }
    </div>
  </div>
</Card>
