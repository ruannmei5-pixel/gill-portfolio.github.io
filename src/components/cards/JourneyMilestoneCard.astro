---
import type { JourneyMilestone } from "@/types";
import TechTag from "@components/ui/TechTag.astro";

export interface Props {
  milestone: JourneyMilestone;
  isLast?: boolean;
}

const { milestone, isLast = false } = Astro.props;

const stageLabel: Record<JourneyMilestone["stage"], string> = {
  origin: "Origin",
  adaptation: "Adaptation",
  leadership: "Leadership",
  discovery: "Discovery",
  achievement: "Achievement",
  "breaking-comfort-zone": "Breaking the comfort zone",
  current: "Still climbing",
};

// Elevation is rendered two ways: a numeric coordinate-style readout
// (matching the instrumentation language used elsewhere — see
// AvatarElevation.astro), and a small rightward indent on md+ screens
// so the story visibly "climbs" as it's read top to bottom. Indent is
// only applied from md up, so mobile never risks horizontal overflow.
const clampedElevation = Math.max(-100, Math.min(100, milestone.elevation));
const indentPx = Math.round(((clampedElevation + 100) / 200) * 56);
const accentMix = Math.round(((clampedElevation + 100) / 200) * 85);
const isCurrent = milestone.stage === "current";
---

<li
  class="relative flex gap-6 pb-12 last:pb-0 md:ml-[var(--elevation-indent)]"
  style={`--elevation-indent: ${indentPx}px`}
>
  <div class="flex flex-col items-center">
    <span class="relative flex h-2.5 w-2.5 shrink-0 items-center justify-center" aria-hidden="true">
      {
        isCurrent ? (
          <span class="absolute h-2.5 w-2.5 rounded-full bg-signal-glow motion-safe:animate-pulse-ring" />
        ) : null
      }
      <span class="h-2.5 w-2.5 rounded-full border-2 border-signal bg-void" />
    </span>
    {
      !isLast ? (
        <span
          class="w-px flex-1"
          style={`background-color: color-mix(in srgb, var(--color-signal) ${accentMix}%, var(--color-border-subtle))`}
          aria-hidden="true"
        />
      ) : null
    }
  </div>

  <div class="max-w-prose pb-2">
    <div class="flex flex-wrap items-center gap-3">
      <span class="font-mono text-xs text-ink-faint">{milestone.period}</span>
      <span
        class:list={[
          "rounded-sm border px-2 py-0.5 font-mono text-[0.6875rem] uppercase tracking-wide",
          isCurrent ? "border-signal-dim text-signal-bright" : "border-border-subtle text-ink-muted",
        ]}
      >
        {stageLabel[milestone.stage]}
      </span>
      <span class="font-mono text-[0.6875rem] text-ink-faint" aria-hidden="true">
        elev {clampedElevation > 0 ? "+" : ""}{clampedElevation}
      </span>
    </div>

    <h3 class="mt-2 font-display text-xl text-ink">{milestone.title}</h3>
    <p class="mt-2 text-ink-muted">{milestone.description}</p>

    {
      milestone.metric ? (
        <p class="mt-3 font-mono text-xs text-signal-bright">
          <span class="text-signal-dim">[ </span>
          {milestone.metric}
          <span class="text-signal-dim"> ]</span>
        </p>
      ) : null
    }

    {
      milestone.tags && milestone.tags.length > 0 ? (
        <div class="mt-3 flex flex-wrap gap-2">
          {milestone.tags.map((tag) => (
            <TechTag>{tag}</TechTag>
          ))}
        </div>
      ) : null
    }
  </div>
</li>
