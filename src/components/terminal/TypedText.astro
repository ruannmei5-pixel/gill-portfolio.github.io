---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class={`${className}`}>
  <slot />
  <span
    class="ml-0.5 inline-block h-[1em] w-[0.5ch] translate-y-[0.15em] bg-signal motion-safe:animate-blink align-middle"
    aria-hidden="true"></span>
</span>
