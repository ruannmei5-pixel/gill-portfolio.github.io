---
import TerminalWindow from "@components/terminal/TerminalWindow.astro";
import { quickQuestions, getGreeting } from "@data/aiKnowledge";

export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const greeting = getGreeting();
// Hanya 4 saran; hilang otomatis setelah pertanyaan pertama.
const suggestions = quickQuestions.slice(0, 4);
---

<TerminalWindow title="GILL AI" class={className}>
  <div class="flex flex-col gap-4 font-body">
    <div class="flex items-center justify-between gap-2">
      <p class="font-mono text-[0.6875rem] text-ink-faint">English / Bahasa Indonesia</p>
      <button
        type="button"
        id="ai-clear"
        class="shrink-0 rounded-sm border border-border-subtle px-2 py-1 font-mono text-[0.6875rem] text-ink-faint transition-colors duration-200 hover:border-signal-dim hover:text-signal-bright"
        aria-label="Clear conversation"
      >
        Clear
      </button>
    </div>

    <div
      id="ai-output"
      class="min-h-[12rem] max-h-[28rem] space-y-4 overflow-y-auto pr-1"
      role="log"
      aria-live="polite"
      aria-atomic="false"
      aria-label="Conversation with Gill AI"
    >
      <div class="flex gap-2.5">
        <span
          class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-signal-dim font-mono text-[0.625rem] text-signal-bright"
          aria-hidden="true">AI</span
        >
        <p
          class="min-w-0 max-w-[90%] whitespace-pre-wrap break-words rounded-md bg-surface-raised px-3.5 py-2.5 text-sm leading-relaxed text-ink"
          data-ai-greeting
        >
          {greeting}
        </p>
      </div>
    </div>

    <p
      id="ai-status"
      class="hidden items-center gap-1 pl-[2.125rem] font-mono text-[0.6875rem] text-signal-bright"
      aria-hidden="true"
    >
      <span id="ai-status-label">Gill AI is thinking</span>
      <span class="inline-flex" aria-hidden="true">
        <span class="ai-thinking-dot motion-safe:animate-pulse">.</span>
        <span class="ai-thinking-dot motion-safe:animate-pulse" style="animation-delay: 150ms;">.</span>
        <span class="ai-thinking-dot motion-safe:animate-pulse" style="animation-delay: 300ms;">.</span>
      </span>
    </p>

    <div class="flex flex-wrap gap-2" id="ai-quick-questions">
      {
        suggestions.map((question) => (
          <button
            type="button"
            data-question={question}
            class="rounded-full border border-border-subtle px-3 py-1.5 text-left text-xs text-ink-muted transition-[color,border-color,transform] duration-200 hover:border-signal-dim hover:text-signal-bright motion-safe:hover:-translate-y-px motion-safe:active:translate-y-0 motion-safe:active:scale-[0.97]"
          >
            {question}
          </button>
        ))
      }
    </div>

    <form
      id="ai-form"
      class="flex items-end gap-2 rounded-md border border-border-strong bg-void px-3 py-2 transition-colors duration-200 focus-within:border-signal-bright"
      autocomplete="off"
    >
      <label for="ai-input" class="sr-only">Ask something about Gill</label>
      <textarea
        id="ai-input"
        name="question"
        rows="1"
        maxlength="300"
        class="min-w-0 flex-1 resize-none overflow-hidden bg-transparent py-1.5 font-body text-sm text-ink placeholder:text-ink-faint focus-visible:outline-none"
        placeholder="Tanya sesuatu tentang Gill…"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"></textarea>
      <button
        type="submit"
        id="ai-send"
        aria-label="Send"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded bg-signal text-void transition-[background-color,transform] duration-200 hover:bg-signal-bright motion-safe:active:scale-[0.94] disabled:cursor-not-allowed disabled:opacity-50"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </form>

    <p class="text-[0.6875rem] text-ink-faint">
      Shift+Enter untuk baris baru · Jawaban berasal dari data portofolio yang terverifikasi.
    </p>
  </div>
</TerminalWindow>

<script>
  import { sendChatMessage, ChatRequestError } from "@/lib/aiEngine";
  import { detectLanguage } from "@/lib/lang";
  import type { ChatMessage } from "@/types";

  const output = document.getElementById("ai-output");
  const status = document.getElementById("ai-status");
  const statusLabel = document.getElementById("ai-status-label");
  const form = document.getElementById("ai-form") as HTMLFormElement | null;
  const input = document.getElementById("ai-input") as HTMLTextAreaElement | null;
  const sendButton = document.getElementById("ai-send") as HTMLButtonElement | null;
  const clearButton = document.getElementById("ai-clear") as HTMLButtonElement | null;
  const quickWrap = document.getElementById("ai-quick-questions");
  const quickButtons = document.querySelectorAll<HTMLButtonElement>("#ai-quick-questions button");
  const greetingEl = document.querySelector<HTMLParagraphElement>("[data-ai-greeting]");
  const GREETING_TEXT = greetingEl?.textContent?.trim() ?? "";

  const prefersReducedMotion =
    typeof window !== "undefined" && "matchMedia" in window
      ? window.matchMedia("(prefers-reduced-motion: reduce)").matches
      : false;

  if (output && form && input && sendButton && clearButton) {
    let history: ChatMessage[] = [];
    let lang: "en" | "id" | undefined;
    let busy = false;
    let lastFailedQuestion: string | null = null;

    function statusText(lang: "en" | "id" | undefined) {
      return lang === "id" ? "Gill AI sedang berpikir" : "Gill AI is thinking";
    }

    function fallbackText(lang: "en" | "id" | undefined) {
      return lang === "id"
        ? "Gill AI lagi mengalami gangguan. Coba lagi beberapa saat."
        : "Gill AI is currently unavailable. You can still explore the portfolio manually through the sections above.";
    }

    function retryLabel(lang: "en" | "id" | undefined) {
      return lang === "id" ? "Coba lagi" : "Retry";
    }

    function autoResize() {
      input!.style.height = "auto";
      input!.style.height = `${Math.min(input!.scrollHeight, 120)}px`;
    }
    input.addEventListener("input", autoResize);
    autoResize();

    function appendMessage(role: "user" | "ai", text: string, animate = false): void {
      const row = document.createElement("div");
      row.className =
        role === "ai"
          ? "flex gap-2.5 motion-safe:animate-fade-up"
          : "flex justify-end motion-safe:animate-fade-up";

      if (role === "ai") {
        const avatar = document.createElement("span");
        avatar.className =
          "mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-signal-dim font-mono text-[0.625rem] text-signal-bright";
        avatar.setAttribute("aria-hidden", "true");
        avatar.textContent = "AI";
        row.appendChild(avatar);
      }

      const bubble = document.createElement("p");
      bubble.className =
        role === "ai"
          ? "min-w-0 max-w-[90%] whitespace-pre-wrap break-words rounded-md bg-surface-raised px-3.5 py-2.5 text-sm leading-relaxed text-ink"
          : "min-w-0 max-w-[85%] whitespace-pre-wrap break-words rounded-md border border-signal-dim bg-signal-wash px-3.5 py-2.5 text-sm leading-relaxed text-ink";
      row.appendChild(bubble);
      output!.appendChild(row);

      // textContent / createTextNode only — never innerHTML.
      function writeLinesInstantly(target: HTMLElement, value: string) {
        const lines = value.split("\n");
        lines.forEach((line, i) => {
          if (i > 0) target.appendChild(document.createElement("br"));
          target.appendChild(document.createTextNode(line));
        });
      }

      if (!animate || prefersReducedMotion) {
        writeLinesInstantly(bubble, text);
        output!.scrollTop = output!.scrollHeight;
        return;
      }

      const words = text.split(/(\s+)/);
      const caret = document.createElement("span");
      caret.className = "ai-caret motion-safe:animate-pulse";
      caret.textContent = "▍";
      caret.setAttribute("aria-hidden", "true");
      bubble.appendChild(caret);

      let i = 0;
      const revealed: string[] = [];
      function step() {
        if (i >= words.length) {
          caret.remove();
          output!.scrollTop = output!.scrollHeight;
          return;
        }
        revealed.push(words[i]);
        i += 1;
        bubble.textContent = "";
        writeLinesInstantly(bubble, revealed.join(""));
        bubble.appendChild(caret);
        output!.scrollTop = output!.scrollHeight;
        window.setTimeout(step, 14);
      }
      step();
    }

    function appendErrorWithRetry(question: string, lang: "en" | "id" | undefined) {
      appendMessage("ai", fallbackText(lang));
      lastFailedQuestion = question;

      const retryRow = document.createElement("div");
      retryRow.className = "flex gap-2.5 motion-safe:animate-fade-up";
      const spacer = document.createElement("span");
      spacer.className = "w-6 shrink-0";
      spacer.setAttribute("aria-hidden", "true");
      retryRow.appendChild(spacer);

      const retryButton = document.createElement("button");
      retryButton.type = "button";
      retryButton.textContent = retryLabel(lang);
      retryButton.className =
        "rounded-sm border border-border-subtle px-2.5 py-1 font-mono text-[0.6875rem] text-signal-bright transition-colors duration-200 hover:border-signal-dim";
      retryButton.addEventListener("click", () => {
        retryRow.remove();
        if (lastFailedQuestion) void handleAsk(lastFailedQuestion);
      });
      retryRow.appendChild(retryButton);
      output!.appendChild(retryRow);
      output!.scrollTop = output!.scrollHeight;
    }

    function setBusy(value: boolean, currentLang?: "en" | "id") {
      busy = value;
      sendButton!.disabled = value;
      input!.disabled = value;
      if (statusLabel) statusLabel.textContent = statusText(currentLang ?? lang);
      status?.classList.toggle("hidden", !value);
      status?.classList.toggle("flex", value);
    }

    const MIN_THINKING_MS = 380;
    const MAX_HISTORY_MESSAGES = 40;

    async function handleAsk(raw: string) {
      const trimmed = raw.trim();
      if (!trimmed || busy) return;

      // Saran pertanyaan disembunyikan setelah percakapan dimulai.
      quickWrap?.classList.add("hidden");

      lang = detectLanguage(trimmed, lang);
      appendMessage("user", trimmed);
      history.push({ role: "user", content: trimmed });
      if (history.length > MAX_HISTORY_MESSAGES) history = history.slice(-MAX_HISTORY_MESSAGES);
      setBusy(true, lang);
      const startedAt = performance.now();

      try {
        const result = await sendChatMessage(history);
        if (!prefersReducedMotion) {
          const elapsed = performance.now() - startedAt;
          const remaining = MIN_THINKING_MS - elapsed;
          if (remaining > 0) await new Promise((resolve) => window.setTimeout(resolve, remaining));
        }
        lang = result.lang ?? lang;
        history.push({ role: "assistant", content: result.text });
        appendMessage("ai", result.text, true);
      } catch (error) {
        if (history[history.length - 1]?.role === "user") history.pop();
        if (error instanceof ChatRequestError && error.status === 429) {
          appendMessage(
            "ai",
            lang === "id"
              ? "Pertanyaannya sudah cukup banyak untuk sekarang. Coba lagi beberapa saat, atau lihat langsung bagian-bagian portofolio di atas."
              : "That's a lot of questions for now. Please try again in a bit, or browse the portfolio sections above.",
          );
        } else {
          appendErrorWithRetry(trimmed, lang);
        }
      } finally {
        setBusy(false);
      }
    }
    

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const value = input.value;
      input.value = "";
      autoResize();
      void handleAsk(value);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        if (!busy) form!.requestSubmit();
      }
    });

    quickButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const question = button.dataset.question ?? "";
        input.value = "";
        autoResize();
        void handleAsk(question);
      });
    });

    clearButton.addEventListener("click", () => {
      if (busy) return;
      history = [];
      lang = undefined;
      lastFailedQuestion = null;
      output.innerHTML = "";
      appendMessage("ai", GREETING_TEXT);
      quickWrap?.classList.remove("hidden");
      input.focus();
    });
  }
</script>