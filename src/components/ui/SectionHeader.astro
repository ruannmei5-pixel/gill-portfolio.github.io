---
export interface Props {
  index: string; // e.g. "01"
  title: string;
  description?: string;
  id?: string;
  /** Small uppercase label above the title, e.g. "The Ascent". Optional. */
  eyebrow?: string;
  /**
   * Styles the title the way the Hero tagline is styled (uppercase,
   * tracked, left accent bar) for sections that want to foreground a
   * concept/mantra rather than a plain section name. Optional —
   * existing sections are unaffected unless they opt in.
   */
  emphasis?: boolean;
}

const { index, title, description, id, eyebrow, emphasis = false } = Astro.props;
---

<div class="mb-10 flex items-start gap-5 md:mb-14 md:gap-8" id={id}>
  <span
    class="mt-1.5 shrink-0 font-mono text-xs text-ink-faint md:mt-2.5 md:text-sm"
    aria-hidden="true">{index}</span
  >
  <div class="max-w-prose">
    {
      eyebrow ? (
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-signal-bright">{eyebrow}</p>
      ) : null
    }
    <h2
      class:list={[
        "font-display text-ink",
        emphasis
          ? "mt-2 border-l-2 border-signal pl-4 text-2xl uppercase tracking-[0.04em] md:text-display-md"
          : "text-display-md",
      ]}
    >
      {title}
    </h2>
    {description ? <p class="mt-3 text-ink-muted">{description}</p> : null}
  </div>
</div>
