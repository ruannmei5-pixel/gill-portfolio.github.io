---
// Pairs the avatar with the "minus → climbing → peak" metaphor,
// rendered as a small coordinate-plot rather than any literal
// mountain/hiking imagery — consistent with the instrumentation
// language used elsewhere (ProgressRail, contour-backdrop).
//
// The avatar comes from `profile.avatarPlaceholder`. Swapping in a
// real photo later only means replacing that file (or updating the
// path in `src/data/profile.ts`) — no markup change needed here.
import { profile } from "@data/profile";
---

<div
  class="group mt-4 flex w-full max-w-md items-center gap-4 rounded-md border border-border-subtle bg-void-raised/60 p-4 shadow-panel transition-colors duration-250 hover:border-signal-dim"
>
  <div
    class="relative h-14 w-14 shrink-0 overflow-hidden rounded-md border border-border-subtle transition-shadow duration-250 group-hover:shadow-[0_0_0_1px_var(--color-signal-dim),0_0_24px_-4px_var(--color-signal-glow)]"
  >
    <img
      src={profile.avatarPlaceholder}
      alt={`${profile.fullName}, ${profile.nickname}`}
      class="h-full w-full object-cover transition-transform duration-250 motion-safe:group-hover:scale-105"
      width="56"
      height="56"
      loading="eager"
    />
  </div>

  <div class="min-w-0 flex-1">
    <svg
      viewBox="0 0 168 56"
      class="h-10 w-full"
      role="img"
      aria-label="Elevation trace from minus to peak: currently still climbing"
    >
      <!-- zero baseline -->
      <line
        x1="0"
        y1="34"
        x2="168"
        y2="34"
        stroke="var(--color-border-subtle)"
        stroke-width="1"
        stroke-dasharray="2 3"
      />
      <text x="0" y="30" font-family="var(--font-mono)" font-size="6" fill="var(--color-ink-faint)">MIN</text>
      <text x="146" y="10" font-family="var(--font-mono)" font-size="6" fill="var(--color-ink-faint)">PEAK</text>

      <!-- ascent line: dips first ("minus"), then climbs -->
      <polyline
        points="4,46 22,50 44,40 68,30 92,24 116,16 140,12"
        fill="none"
        stroke="var(--color-signal)"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <!-- faint dashed continuation toward the (unreached) peak -->
      <polyline
        points="140,12 168,4"
        fill="none"
        stroke="var(--color-signal-dim)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-dasharray="2 3"
      />

      <!-- current-position marker -->
      <circle
        cx="140"
        cy="12"
        r="5"
        fill="var(--color-signal-glow)"
        class="motion-safe:animate-pulse-ring"
        style="transform-origin: 140px 12px;"
      />
      <circle cx="140" cy="12" r="2.5" fill="var(--color-signal-bright)" />
    </svg>
  </div>
</div>
